PORT=3001
NODE_ENV=development
ADMIN_API_TOKEN=""
APP_URL="http://localhost:3000"
# Base pública dos links de checkout (sem barra final)
PAYMENT_LINK_BASE_URL="https://nextpay.link/silva-design"
# Origem permitida no CORS da API (deve coincidir com o frontend Vite em dev; em produção use a URL pública)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/nextpay"
DATABASE_URL_TEST="postgresql://usuario:senha@localhost:5432/nextpay_test"
# Chave API Asaas (Integrações → API). Ver também .env.hostinger.example (Hostinger + sandbox).
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"
# Opcional: alias do WEBHOOK_INBOUND_SECRET (token configurado no Asaas → Webhooks)
ASAAS_WEBHOOK_TOKEN=""
# Token inbound: copie o mesmo valor para "Token de autenticação" do webhook Asaas
WEBHOOK_INBOUND_SECRET=""
MERCHANT_API_KEY=""
# Token Bearer para jobs internos (ex.: retentativas de webhook outbound)
INTERNAL_JOB_TOKEN=""
# Frontend: fallbacks locais de demo (build prod padrão false via vite)
VITE_DEMO_MODE="false"
MERCHANT_LOGIN_EMAIL="lojista@nextpay.test"
MERCHANT_LOGIN_PASSWORD=""
MERCHANT_DISPLAY_NAME="Lojista Demo"
MERCHANT_WEBHOOK_URL=""
JWT_SECRET=""
# fixture | in_memory = adaptador simulado; omita ou use outro valor para HTTP primário + vault
PAYMENT_GATEWAY_MODE="fixture"
# Obrigatório fora do modo fixture (32 bytes Base64 ou 64 hex). Tokens np_sec_test_* também usam adaptador simulado.
MASTER_ENCRYPTION_KEY=""
# Padrão aplicado na subida se vazio: https://sandbox.asaas.com/api/v3 e https://api.asaas.com/v3
PROCESSOR_API_BASE_URL_SANDBOX=""
PROCESSOR_API_BASE_URL_PRODUCTION=""
# Carteira NextPay para split de comissão (opcional)
NEXTPAY_WALLET_ID=""
# Percentual de split para a carteira NextPay (0–100, padrão 1)
NEXTPAY_SPLIT_PERCENT=""
