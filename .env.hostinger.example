# =============================================================================
# NextPay — template Hostinger (copie para `.env` no painel ou no VPS)
# Preencha os valores entre aspas. Comentários em português indicam onde achar
# cada dado no painel Asaas (Integrações → API / Webhooks).
# =============================================================================

# --- Servidor ---
PORT="3001"
NODE_ENV="production"
# URL pública do painel (CORS + links). Ex.: https://app.seudominio.com.br
APP_URL="https://SEU_DOMINIO"
# Base dos links de checkout (sem barra no final)
PAYMENT_LINK_BASE_URL="https://SEU_DOMINIO/checkout"

# --- Banco (Hostinger PostgreSQL ou externo) ---
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/nextpay?schema=public"

# --- Modo gateway ---
# Omita PAYMENT_GATEWAY_MODE ou deixe vazio em produção real.
# Use "fixture" só para demo sem Asaas.
PAYMENT_GATEWAY_MODE=""
# Chave mestra AES-256 (32 bytes). Gere: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=""

# --- Asaas: SANDBOX (homologação) ---
# Integrações → API → Chave de API (ambiente Sandbox)
ASAAS_API_KEY=""
# sandbox | production — controla vault SANDBOX vs PRODUCTION e webhooks inbound
ASAAS_ENV="sandbox"
# Opcional: mesmo valor que WEBHOOK_INBOUND_SECRET (alias legado interno)
ASAAS_WEBHOOK_TOKEN=""

# --- URLs HTTP do processador (mapeadas do Asaas) ---
# Sandbox: documentação Asaas v3 — https://sandbox.asaas.com/api/v3
PROCESSOR_API_BASE_URL_SANDBOX="https://sandbox.asaas.com/api/v3"
# Produção (descomente quando for ao ar):
# PROCESSOR_API_BASE_URL_PRODUCTION="https://api.asaas.com/v3"
PROCESSOR_API_BASE_URL_PRODUCTION=""

# --- Webhook INBOUND (Asaas → NextPay) ---
# Opção A (recomendada): painel NextPay → Taxas & Conexões → credenciais por ambiente
#   (Token webhook salvo criptografado no vault SANDBOX / PRODUÇÃO).
# Opção B (fallback global no servidor):
WEBHOOK_INBOUND_SECRET=""
# No Asaas: Integrações → Webhooks → URL https://SEU_DOMINIO/api/v1/webhooks/inbound
# Campo "Token de autenticação" = mesmo valor colado no painel NextPay (ou WEBHOOK_INBOUND_SECRET)
# Cabeçalhos aceitos: asaas-access-token ou x-nextpay-webhook-token

# --- Split / comissão NextPay (opcional) ---
# Preferência: Wallet ID por ambiente no painel (vault). Fallback global:
NEXTPAY_WALLET_ID=""
NEXTPAY_SPLIT_PERCENT="1"

# --- Asaas PRODUÇÃO (comentado até go-live) ---
# ASAAS_ENV="production"
# ASAAS_API_KEY="$SUA_CHAVE_PRODUCAO"
# PROCESSOR_API_BASE_URL_PRODUCTION="https://api.asaas.com/v3"

# --- Autenticação painel / API ---
JWT_SECRET=""
MERCHANT_LOGIN_EMAIL=""
MERCHANT_LOGIN_PASSWORD=""
MERCHANT_DISPLAY_NAME=""
ADMIN_API_TOKEN=""
INTERNAL_JOB_TOKEN=""
MERCHANT_API_KEY=""

# --- Webhooks outbound (NextPay → sua loja / WooCommerce) ---
MERCHANT_WEBHOOK_URL=""

# --- Frontend ---
VITE_DEMO_MODE="false"
