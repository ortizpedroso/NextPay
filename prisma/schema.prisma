generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Ambiente operacional das credenciais do processador subjacente (uso exclusivo servidor).
enum GatewayEnvironment {
  SANDBOX
  PRODUCTION
}

/// Vault criptografado de credenciais da plataforma NextPay (nunca expor plaintext ao cliente).
model ProcessorCredentialVault {
  id              String             @id @default(cuid())
  environment     GatewayEnvironment @unique
  /// Payload AES-256-GCM serializado (JSON: v, iv, tag, ct).
  ciphertext      String             @db.Text
  /// Prefixo exibido na UI mascarada (ex.: sk_live, sk_test).
  prefixHint      String             @db.VarChar(32)
  /// Últimos 4 caracteres do segredo (somente para máscara).
  suffixHint      String             @db.VarChar(8)
  /// Incrementado a cada rotação/regravação do segredo.
  rotationVersion Int                @default(1)
  lastValidatedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

/// Chaves de idempotência para operações de pagamento (evita duplicidade em retries/webhooks).
model PaymentIdempotencyKey {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique @db.VarChar(128)
  operation      String   @db.VarChar(64)
  requestHash    String   @db.VarChar(128)
  responseJson   String   @db.Text
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
}

/// Correlação entre IDs neutros NextPay e IDs do processador subjacente.
model PaymentIdMapping {
  id          String             @id @default(cuid())
  neutralId   String             @unique @db.VarChar(80)
  externalId  String             @db.VarChar(80)
  entityType  String             @db.VarChar(16)
  environment GatewayEnvironment
  createdAt   DateTime           @default(now())

  @@index([externalId, environment])
}

/// Registro de webhooks inbound já processados (idempotência).
model InboundWebhookEvent {
  id               String   @id @default(cuid())
  eventFingerprint String   @unique @db.VarChar(128)
  eventType        String   @db.VarChar(64)
  payloadJson      String   @db.Text
  createdAt        DateTime @default(now())
}

model CheckoutSession {
  id               String             @id @default(cuid())
  sessionPublicId  String             @unique @db.VarChar(64)
  amountCents      Int
  description      String             @db.VarChar(500)
  method           String             @db.VarChar(32)
  status           String             @db.VarChar(32)
  paymentId        String?            @db.VarChar(80)
  pixCopyPaste     String?            @db.Text
  customerName     String             @db.VarChar(140)
  customerEmail    String             @db.VarChar(180)
  customerDocument String             @db.VarChar(18)
  environment      GatewayEnvironment @default(SANDBOX)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model MerchantCustomer {
  id                String   @id @default(cuid())
  neutralCustomerId String   @unique @db.VarChar(80)
  name              String   @db.VarChar(140)
  email             String   @db.VarChar(180)
  document          String   @db.VarChar(18)
  createdAt         DateTime @default(now())
}

model LedgerTransaction {
  id               String   @id @default(cuid())
  neutralPaymentId String   @unique @db.VarChar(80)
  amountCents      Int
  netAmountCents   Int?
  status           String   @db.VarChar(32)
  method           String   @db.VarChar(32)
  description      String   @db.VarChar(500)
  customerName     String?  @db.VarChar(140)
  createdAt        DateTime @default(now())
}

model OutboundWebhookDelivery {
  id          String   @id @default(cuid())
  targetUrl   String   @db.VarChar(500)
  eventType   String   @db.VarChar(64)
  payloadJson String   @db.Text
  status      String   @db.VarChar(32)
  createdAt   DateTime @default(now())
}

/// Item do catálogo do lojista (produto, serviço ou plano recorrente).
model CatalogProduct {
  id              String   @id @default(cuid())
  productPublicId String   @unique @db.VarChar(80)
  urlSlug         String   @unique @db.VarChar(120)
  title           String   @db.VarChar(200)
  description     String   @db.Text
  category        String   @db.VarChar(32)
  badge           String?  @db.VarChar(64)
  priceCents      Int
  billingType     String   @db.VarChar(16)
  recurrencyCycle String?  @db.VarChar(64)
  maxInstallments Int      @default(12)
  imageUrl        String   @db.Text
  salesCount      Int      @default(0)
  status          String   @default("ACTIVE") @db.VarChar(16)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Link reutilizável de cobrança / checkout.
model PaymentLink {
  id               String    @id @default(cuid())
  linkPublicId     String    @unique @db.VarChar(80)
  urlSlug          String    @unique @db.VarChar(120)
  title            String    @db.VarChar(200)
  subtitle         String    @db.VarChar(500)
  billingType      String    @db.VarChar(16)
  status           String    @default("ACTIVE") @db.VarChar(16)
  amountCents      Int
  totalBilledCents Int       @default(0)
  salesCount       Int       @default(0)
  viewCount        Int       @default(0)
  expiresAt        DateTime?
  productPublicId  String?   @db.VarChar(80)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([productPublicId])
}
