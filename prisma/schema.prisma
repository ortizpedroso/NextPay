generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Ambiente operacional das credenciais do processador subjacente (uso exclusivo servidor).
enum GatewayEnvironment {
  SANDBOX
  PRODUCTION
}

/// Lojista (tenant) da plataforma SaaS multi-merchant.
model Merchant {
  id               String   @id @default(cuid())
  merchantPublicId String   @unique @db.VarChar(80)
  displayName      String   @db.VarChar(200)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users              MerchantUser[]
  catalogProducts    CatalogProduct[]
  paymentLinks       PaymentLink[]
  merchantCustomers  MerchantCustomer[]
  ledgerTransactions LedgerTransaction[]
  checkoutSessions   CheckoutSession[]
  subscriptions      Subscription[]
  merchantApiKeys    MerchantApiKey[]
  integrations       MerchantIntegration[]
}

/// Usuário de painel vinculado a um lojista.
model MerchantUser {
  id         String   @id @default(cuid())
  merchantId String
  email      String   @unique @db.VarChar(180)
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

/// Vault criptografado de credenciais da plataforma NextPay (nunca expor plaintext ao cliente).
model ProcessorCredentialVault {
  id              String             @id @default(cuid())
  environment     GatewayEnvironment @unique
  /// Payload AES-256-GCM serializado (JSON: v, iv, tag, ct).
  ciphertext      String             @db.Text
  /// Prefixo exibido na UI mascarada (ex.: sk_live, sk_test).
  prefixHint      String             @db.VarChar(32)
  /// Últimos 4 caracteres do segredo (somente para máscara).
  suffixHint      String             @db.VarChar(8)
  /// Incrementado a cada rotação/regravação do segredo.
  rotationVersion Int                @default(1)
  lastValidatedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

/// Chaves de idempotência para operações de pagamento (evita duplicidade em retries/webhooks).
model PaymentIdempotencyKey {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique @db.VarChar(128)
  operation      String   @db.VarChar(64)
  requestHash    String   @db.VarChar(128)
  responseJson   String   @db.Text
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
}

/// Correlação entre IDs neutros NextPay e IDs do processador subjacente.
model PaymentIdMapping {
  id          String             @id @default(cuid())
  neutralId   String             @unique @db.VarChar(80)
  externalId  String             @db.VarChar(80)
  entityType  String             @db.VarChar(16)
  environment GatewayEnvironment
  createdAt   DateTime           @default(now())

  @@index([externalId, environment])
}

/// Registro de webhooks inbound já processados (idempotência).
model InboundWebhookEvent {
  id               String   @id @default(cuid())
  eventFingerprint String   @unique @db.VarChar(128)
  eventType        String   @db.VarChar(64)
  payloadJson      String   @db.Text
  createdAt        DateTime @default(now())
}

model CheckoutSession {
  id                   String             @id @default(cuid())
  merchantId           String
  merchant             Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  sessionPublicId      String             @unique @db.VarChar(64)
  amountCents          Int
  description          String             @db.VarChar(500)
  method               String             @db.VarChar(32)
  status               String             @db.VarChar(32)
  paymentId            String?            @db.VarChar(80)
  pixCopyPaste         String?            @db.Text
  customerName         String             @db.VarChar(140)
  customerEmail        String             @db.VarChar(180)
  customerDocument     String             @db.VarChar(18)
  paymentLinkPublicId  String?            @db.VarChar(80)
  productPublicId      String?            @db.VarChar(80)
  environment          GatewayEnvironment @default(SANDBOX)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([paymentLinkPublicId])
  @@index([productPublicId])
  @@index([merchantId])
}

model MerchantCustomer {
  id                String   @id @default(cuid())
  merchantId        String
  merchant          Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  neutralCustomerId String   @unique @db.VarChar(80)
  name              String   @db.VarChar(140)
  email             String   @db.VarChar(180)
  document          String   @db.VarChar(18)
  createdAt         DateTime @default(now())

  @@index([merchantId])
}

model LedgerTransaction {
  id               String   @id @default(cuid())
  merchantId       String
  merchant         Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  neutralPaymentId String   @unique @db.VarChar(80)
  amountCents      Int
  netAmountCents   Int?
  status           String   @db.VarChar(32)
  method           String   @db.VarChar(32)
  description      String   @db.VarChar(500)
  customerName     String?  @db.VarChar(140)
  createdAt        DateTime @default(now())

  @@index([merchantId])
}

model OutboundWebhookDelivery {
  id           String    @id @default(cuid())
  targetUrl    String    @db.VarChar(500)
  eventType    String    @db.VarChar(64)
  payloadJson  String    @db.Text
  status       String    @db.VarChar(32)
  attemptCount Int       @default(0)
  maxAttempts  Int       @default(5)
  nextRetryAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, nextRetryAt])
}

/// Assinatura recorrente de um cliente (enrollment).
model Subscription {
  id                   String   @id @default(cuid())
  merchantId           String
  merchant             Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  subscriptionPublicId String   @unique @db.VarChar(80)
  productPublicId      String?  @db.VarChar(80)
  planTitle            String   @db.VarChar(200)
  priceCents           Int
  cadenceLabel         String   @db.VarChar(128)
  customerName         String   @db.VarChar(140)
  customerEmail        String   @db.VarChar(180)
  paymentMethod        String   @db.VarChar(64)
  status               String   @default("ACTIVE") @db.VarChar(32)
  nextBillingAt        DateTime
  totalPaidCents       Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  cycles SubscriptionCycle[]

  @@index([merchantId])
  @@index([merchantId, status])
}

/// Ciclo de cobrança de uma assinatura.
model SubscriptionCycle {
  id               String       @id @default(cuid())
  subscriptionId   String
  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  cyclePublicId    String       @unique @db.VarChar(80)
  dueAt            DateTime
  amountCents      Int
  status           String       @default("PENDING") @db.VarChar(32)
  neutralPaymentId String?      @db.VarChar(80)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([subscriptionId])
  @@index([dueAt, status])
}

/// Chave de API do lojista (np_sec_*); hash armazenado, plaintext exibido apenas na criação/rotação.
model MerchantApiKey {
  id          String    @id @default(cuid())
  merchantId  String
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  keyPublicId String    @unique @db.VarChar(80)
  prefixHint  String    @db.VarChar(24)
  suffixHint  String    @db.VarChar(8)
  keyHash     String    @db.VarChar(128)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([merchantId])
}

/// Estado de conectores e-commerce por lojista.
model MerchantIntegration {
  id          String    @id @default(cuid())
  merchantId  String
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  platform    String    @db.VarChar(32)
  status      String    @default("DISCONNECTED") @db.VarChar(32)
  connectedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([merchantId, platform])
  @@index([merchantId])
}

/// Item do catálogo do lojista (produto, serviço ou plano recorrente).
model CatalogProduct {
  id              String   @id @default(cuid())
  merchantId      String
  merchant        Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  productPublicId String   @unique @db.VarChar(80)
  urlSlug         String   @unique @db.VarChar(120)
  title           String   @db.VarChar(200)
  description     String   @db.Text
  category        String   @db.VarChar(32)
  badge           String?  @db.VarChar(64)
  priceCents      Int
  billingType     String   @db.VarChar(16)
  recurrencyCycle String?  @db.VarChar(64)
  maxInstallments Int      @default(12)
  imageUrl        String   @db.Text
  salesCount      Int      @default(0)
  status          String   @default("ACTIVE") @db.VarChar(16)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([merchantId])
}

/// Link reutilizável de cobrança / checkout.
model PaymentLink {
  id               String    @id @default(cuid())
  merchantId       String
  merchant         Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  linkPublicId     String    @unique @db.VarChar(80)
  urlSlug          String    @unique @db.VarChar(120)
  title            String    @db.VarChar(200)
  subtitle         String    @db.VarChar(500)
  billingType      String    @db.VarChar(16)
  status           String    @default("ACTIVE") @db.VarChar(16)
  amountCents      Int
  totalBilledCents Int       @default(0)
  salesCount       Int       @default(0)
  viewCount        Int       @default(0)
  expiresAt        DateTime?
  productPublicId  String?   @db.VarChar(80)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([productPublicId])
  @@index([merchantId])
}
